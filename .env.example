# Optional Wrangler configuration. `npm run dev:local` needs no credentials.
# Copy to .dev.vars and replace placeholders; never commit a populated secret file.
AUTH_MODE=cloudflare-access
PLATFORM_HOST=admin.example.com
BOOTSTRAP_OWNER_EMAIL=operator@example.com
ALLOWED_EMAIL_DOMAIN=example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-audience
KEY_ENCRYPTION_SECRET=replace-with-base64-encoded-32-random-bytes
SESSION_SECRET=replace-with-an-independent-random-signing-secret
CF_ZONE_ID=your-saas-zone-id
CF_API_TOKEN=replace-with-a-custom-hostnames-scoped-api-token
WEBHOOK_VERIFY_SIGNATURES=true
# Parent and customer email keys are linked through the consoles, not Worker vars.
# LOCAL_TEST must never be enabled in a deployed environment.
